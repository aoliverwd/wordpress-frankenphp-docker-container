{
    "config": {
        "platform": {
            "php": "8.5"
        },
        "preferred-install": {
            "*": "dist"
        },
        "allow-plugins": true
    },
    "require": {
        "php": ">=8.5",
        "composer/installers": "^2.3",
        "wp-plugin/sqlite-database-integration": "^2.2",
        "wp-plugin/wordfence": "^8.2",
        "wp-plugin/duplicate-post": "^4.6",
        "wp-plugin/wordpress-seo": "^27.8"
    },
    "repositories": [
        {
            "name": "wp-packages",
            "type": "composer",
            "url": "https://repo.wp-packages.org"
        }
    ],
    "extra": {
        "installer-paths": {
            "wp-content/plugins/{$name}/": [
                "type:wordpress-plugin"
            ],
            "wp-content/mu-plugins/{$name}/": [
                "type:wordpress-muplugin"
            ]
        }
    }
}
